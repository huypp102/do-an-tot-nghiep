# Copy file này thành `.env` (cùng thư mục docker-compose.yml) rồi sửa giá trị.
#   cp .env.example .env
# File `.env` KHÔNG được commit (đã .gitignore) vì có thể chứa API key.

# --- Dataset -----------------------------------------------------------
# Đường dẫn TRÊN MÁY HOST tới thư mục dataset đã tải về.
# Ví dụ trên máy thuê GPU:
#   REPOTRANSBENCH_HOST_PATH=/mnt/data/RepoTransBench
# Để trống thì compose dùng ./data/RepoTransBench (có thể chưa tồn tại --
# lúc đó pipeline báo lỗi kèm hướng dẫn, không crash).
REPOTRANSBENCH_HOST_PATH=./data/RepoTransBench

# Đường dẫn BÊN TRONG container tới thư mục chứa các repo Python.
# Thường không cần đổi, trừ khi cấu trúc dataset khác.
REPOTRANSBENCH_ROOT=/app/data/RepoTransBench/source_projects/Python

# --- Model local (Ollama) ---------------------------------------------
# Model dùng cho llm.backend=local. Nhớ pull sau khi container chạy:
#   docker compose exec ollama ollama pull llama3.2:1b
OLLAMA_MODEL=llama3.2:1b
OLLAMA_PORT=11434

# --- API backend (tuỳ chọn) -------------------------------------------
# Chỉ cần khi muốn chạy llm.backend=api song song để so sánh.
# KHÔNG commit file .env chứa key thật.
ANTHROPIC_API_KEY=
